@@ -2,6 +2,25 @@ import XCTest
 @testable import MetalErgoCore
 
 final class ConsensusTests: XCTestCase {
+    func testSegmentedBlake2bAtEveryBoundary() {
+        for count in [0, 1, 7, 8, 127, 128, 129, 255, 256, 257, 8_200] {
+            let input = (0..<count).map { UInt8(truncatingIfNeeded: $0) }
+            let expected = Blake2b256.hash(input)
+            let splits = Set([0, count / 2, count] + [1, 7, 8, 120, 127, 128, 129, 256].filter { $0 <= count })
+            for split in splits {
+                XCTAssertEqual(Blake2b256.hash(prefix: input.span.extracting(0..<split),
+                                              suffix: input.span.extracting(split..<count)), expected,
+                               "length=\(count), split=\(split)")
+                // Separate storage makes suffix word reads physically unaligned
+                // for splits such as 1 and 7, unlike two views of one array.
+                let prefix = Array(input.prefix(split))
+                let suffix = Array(input.dropFirst(split))
+                XCTAssertEqual(Blake2b256.hash(prefix: prefix.span, suffix: suffix.span), expected,
+                               "separate buffers: length=\(count), split=\(split)")
+            }
+        }
+    }
+
     func testBlake2b256Vectors() {
