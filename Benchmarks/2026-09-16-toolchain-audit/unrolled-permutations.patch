@@ -2,6 +2,25 @@ import XCTest
 @testable import MetalErgoCore
 
 final class ConsensusTests: XCTestCase {
+    func testBlakeRoundExpansionAtBlockBoundaries() {
+        // Independent expected digests generated by Python hashlib.blake2b(digest_size=32).
+        let vectors: [(Int, String)] = [
+            (127, "5eb453fad3aba4ac0184f3b63d4add77c7453e1c1c413a5971d5e060b650696a"),
+            (128, "f311c43d2c881a0dff6e7516bdc2922d6eb48aadf92b92c56ddb0aa9178d218d"),
+            (129, "02d9758eca269ae56a704405b250c7a3884bc1251acb213e22f730df43e8d960"),
+            (255, "cb5bff403cd53e49be5a23918a28b2301b6b90a1d4b73d0b2a845811f536812a"),
+            (256, "b604b8d9f273736daebea660e7e6e55f82cb70961943a3dfc35fe679ca88e997"),
+            (257, "564a558c409d211eb25454f1b7289a770f14cf1338169f5edb129b0c67490011"),
+            (8199, "684e0e64ee6c0a12a7e727763e9e56c5f50c2ffc9af692fb5dabb0b754652f69"),
+            (8200, "598ccc177bc37dec7d7ecb9989ebc1e09be17d6ae155d55208e75ac6df54e917"),
+            (8201, "5f8f2419e96e9d3b0f724aa730ea1654f393285d346e0d2415e4ffcb7ecf0790"),
+        ]
+        for (count, expected) in vectors {
+            let input = (0..<count).map { UInt8(truncatingIfNeeded: $0 * 17 + count) }
+            XCTAssertEqual(Blake2b256.hash(input).hex, expected, "count=\(count)")
+        }
+    }
+
     func testBlake2b256Vectors() {
         XCTAssertEqual(Blake2b256.hash([]).hex,
             "0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8")
