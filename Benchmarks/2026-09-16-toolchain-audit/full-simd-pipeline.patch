diff --git a/Tests/MetalErgoCoreTests/ConsensusTests.swift b/Tests/MetalErgoCoreTests/ConsensusTests.swift
index dd9065b..02094d1 100644
--- a/Tests/MetalErgoCoreTests/ConsensusTests.swift
+++ b/Tests/MetalErgoCoreTests/ConsensusTests.swift
@@ -2,6 +2,27 @@ import XCTest
 @testable import MetalErgoCore
 
 final class ConsensusTests: XCTestCase {
+    func testFullSIMDAndPartialSearchGroupsMatchCPU() throws {
+        let solver = try MetalAutolykosSolver(searchThreadgroupSize: 128)
+        let height = 614_401, tableSize = 257
+        _ = try solver.buildDataset(height: height, tableSize: tableSize)
+        let message = [UInt8](repeating: 0x53, count: 32)
+        let hits = try (0..<129).map { i in
+            try AutolykosV2.hit(message: message,
+                nonce: [UInt8](repeating: 0, count: 7) + [UInt8(i)],
+                height: height, tableSize: tableSize)
+        }
+        let target = hits[31]
+        for group in [1, 33, 64, 128] {
+            for count in [1, 31, 32, 33, 63, 64, 65, 127, 128, 129] {
+                let expected = (0..<count).filter { hits[$0] < target }.map(UInt64.init)
+                let batch = try solver.search(message: message, target: target,
+                    baseNonce: 0, nonceCount: count, threadgroupSize: group)
+                XCTAssertEqual(batch.candidates, expected, "group=\(group), count=\(count)")
+            }
+        }
+    }
+
     func testBlake2b256Vectors() {
         XCTAssertEqual(Blake2b256.hash([]).hex,
             "0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8")
