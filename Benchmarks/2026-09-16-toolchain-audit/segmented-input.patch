diff --git a/Sources/MetalErgoCore/Blake2b.swift b/Sources/MetalErgoCore/Blake2b.swift
index e91c05c..a23df46 100644
--- a/Sources/MetalErgoCore/Blake2b.swift
+++ b/Sources/MetalErgoCore/Blake2b.swift
@@ -90,6 +90,38 @@ public enum Blake2b256 {
 
         return (0..<32).map { UInt8(truncatingIfNeeded: h[$0 / 8] >> (($0 % 8) * 8)) }
     }
+
+    /// Hash two borrowed regions without allocating their concatenation.
+    /// Only a block crossing the region boundary needs a temporary copy.
+    static func hash(prefix: Span<UInt8>, suffix: Span<UInt8>) -> [UInt8] {
+        let count = prefix.count + suffix.count
+        var h = iv
+        h[0] ^= 0x0101_0020
+        if count == 0 {
+            compress(&h, block: prefix, count: 0, final: true)
+        } else {
+            var offset = 0
+            while offset < count {
+                let end = offset + min(128, count - offset)
+                if end <= prefix.count {
+                    compress(&h, block: prefix.extracting(offset..<end),
+                             count: UInt64(end), final: end == count)
+                } else if offset >= prefix.count {
+                    compress(&h, block: suffix.extracting((offset - prefix.count)..<(end - prefix.count)),
+                             count: UInt64(end), final: end == count)
+                } else {
+                    var block = InlineArray<128, UInt8>(repeating: 0)
+                    for i in offset..<end {
+                        block[i - offset] = i < prefix.count ? prefix[i] : suffix[i - prefix.count]
+                    }
+                    compress(&h, block: block.span.extracting(0..<(end - offset)),
+                             count: UInt64(end), final: end == count)
+                }
+                offset = end
+            }
+        }
+        return (0..<32).map { UInt8(truncatingIfNeeded: h[$0 / 8] >> (($0 % 8) * 8)) }
+    }
 }
 
